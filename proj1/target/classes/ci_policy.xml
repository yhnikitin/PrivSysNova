<?xml version="1.0" encoding="UTF-8"?>
<PolicySet xmlns="urn:oasis:names:tc:xacml:3.0:core:schema:wd-17"
           PolicySetId="ROOT"
           Version="1.0"
           PolicyCombiningAlgId="urn:oasis:names:tc:xacml:1.0:policy-combining-algorithm:first-applicable">
    <Target />
    <PolicySet PolicySetId="GDPRPolicySet"
               Version="1.0"
               PolicyCombiningAlgId="urn:oasis:names:tc:xacml:1.0:policy-combining-algorithm:first-applicable">
        <Target />
        <Policy PolicyId="ConsentPolicy" Version="1.0"
                RuleCombiningAlgId="urn:oasis:names:tc:xacml:1.0:rule-combining-algorithm:first-applicable">
            <Description>
                Marketing actions are permitted only when the subject has granted marketing consent
                and that consent has not been withdrawn; otherwise they are denied.
            </Description>
            <Target>
                <AnyOf><AllOf>
                    <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                        <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">marketing</AttributeValue>
                        <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:action"
                                             AttributeId="action-id"
                                             DataType="http://www.w3.org/2001/XMLSchema#string"
                                             MustBePresent="false"/>
                    </Match>
                </AllOf></AnyOf>
            </Target>
            <Rule RuleId="PermitMarketingWithActiveConsent" Effect="Permit">
                <Condition>
                    <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:and">
                        <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                            <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">true</AttributeValue>
                            <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-one-and-only">
                                <AttributeDesignator Category="urn:oasis:names:tc:xacml:1.0:subject-category:access-subject"
                                                     AttributeId="consent-marketing"
                                                     DataType="http://www.w3.org/2001/XMLSchema#string"
                                                     MustBePresent="true"/>
                            </Apply>
                        </Apply>
                        <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                            <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">false</AttributeValue>
                            <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-one-and-only">
                                <AttributeDesignator Category="urn:oasis:names:tc:xacml:1.0:subject-category:access-subject"
                                                     AttributeId="consent-withdrawn"
                                                     DataType="http://www.w3.org/2001/XMLSchema#string"
                                                     MustBePresent="true"/>
                            </Apply>
                        </Apply>
                    </Apply>
                </Condition>
            </Rule>
            <Rule RuleId="DenyMarketingWithoutActiveConsent" Effect="Deny"/>
        </Policy>

        <Policy PolicyId="ErasurePolicy" Version="1.0"
                RuleCombiningAlgId="urn:oasis:names:tc:xacml:1.0:rule-combining-algorithm:first-applicable">
            <Description>While an erasure request is active, only the DPO is permitted; everyone else is denied.</Description>
            <Target>
                <AnyOf><AllOf>
                    <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                        <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">true</AttributeValue>
                        <AttributeDesignator Category="urn:oasis:names:tc:xacml:1.0:subject-category:access-subject"
                                             AttributeId="erasure-requested"
                                             DataType="http://www.w3.org/2001/XMLSchema#string"
                                             MustBePresent="false"/>
                    </Match>
                </AllOf></AnyOf>
            </Target>
            <Rule RuleId="PermitDPODuringErasure" Effect="Permit">
                <Target>
                    <AnyOf><AllOf>
                        <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                            <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">DPO</AttributeValue>
                            <AttributeDesignator Category="urn:oasis:names:tc:xacml:1.0:subject-category:access-subject"
                                                 AttributeId="role"
                                                 DataType="http://www.w3.org/2001/XMLSchema#string"
                                                 MustBePresent="false"/>
                        </Match>
                    </AllOf></AnyOf>
                </Target>
            </Rule>
            <Rule RuleId="DenyDuringErasureExceptDPO" Effect="Deny"/>
        </Policy>

        <Policy PolicyId="RetentionPolicy" Version="1.0"
                RuleCombiningAlgId="urn:oasis:names:tc:xacml:1.0:rule-combining-algorithm:first-applicable">
            <Description>After retention expires, only Auditors and DPOs are permitted; everyone else is denied.</Description>
            <Target>
                <AnyOf><AllOf>
                    <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                        <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">true</AttributeValue>
                        <AttributeDesignator Category="urn:oasis:names:tc:xacml:1.0:subject-category:access-subject"
                                             AttributeId="retention-expired"
                                             DataType="http://www.w3.org/2001/XMLSchema#string"
                                             MustBePresent="false"/>
                    </Match>
                </AllOf></AnyOf>
            </Target>
            <Rule RuleId="PermitAuditorOrDPOAfterRetention" Effect="Permit">
                <Target>
                    <AnyOf>
                        <AllOf>
                            <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                                <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">Auditor</AttributeValue>
                                <AttributeDesignator Category="urn:oasis:names:tc:xacml:1.0:subject-category:access-subject"
                                                     AttributeId="role"
                                                     DataType="http://www.w3.org/2001/XMLSchema#string"
                                                     MustBePresent="false"/>
                            </Match>
                        </AllOf>
                        <AllOf>
                            <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                                <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">DPO</AttributeValue>
                                <AttributeDesignator Category="urn:oasis:names:tc:xacml:1.0:subject-category:access-subject"
                                                     AttributeId="role"
                                                     DataType="http://www.w3.org/2001/XMLSchema#string"
                                                     MustBePresent="false"/>
                            </Match>
                        </AllOf>
                    </AnyOf>
                </Target>
            </Rule>
            <Rule RuleId="DenyAfterRetentionExceptAuditorOrDPO" Effect="Deny"/>
        </Policy>
        <Policy PolicyId="SpecialCategoryPolicy" Version="1.0"
                RuleCombiningAlgId="urn:oasis:names:tc:xacml:1.0:rule-combining-algorithm:first-applicable">
            <Description>Deny health-data access unless research consent is explicitly true.</Description>
            <Target>
                <AnyOf>
                    <AllOf>
                        <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                            <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">health-data</AttributeValue>
                            <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:resource"
                                                 AttributeId="data-category"
                                                 DataType="http://www.w3.org/2001/XMLSchema#string"
                                                 MustBePresent="false"/>
                        </Match>
                    </AllOf>
                </AnyOf>
            </Target>
            <Rule RuleId="DenyHealthDataWithoutResearchConsent" Effect="Deny">
                <Condition>
                    <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:not">
                        <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                            <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">true</AttributeValue>
                            <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-one-and-only">
                                <AttributeDesignator Category="urn:oasis:names:tc:xacml:1.0:subject-category:access-subject"
                                                     AttributeId="consent-research"
                                                     DataType="http://www.w3.org/2001/XMLSchema#string"
                                                     MustBePresent="true"/>
                            </Apply>
                        </Apply>
                    </Apply>
                </Condition>
            </Rule>
        </Policy>
        <Policy PolicyId="LawfulBasisPolicy" Version="1.0"
                RuleCombiningAlgId="urn:oasis:names:tc:xacml:1.0:rule-combining-algorithm:first-applicable">
            <Description>Deny read actions unless the lawful basis is one of the six permitted GDPR bases.</Description>
            <Target>
                <AnyOf>
                    <AllOf>
                        <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                            <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">read</AttributeValue>
                            <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:action"
                                                 AttributeId="action-id"
                                                 DataType="http://www.w3.org/2001/XMLSchema#string"
                                                 MustBePresent="false"/>
                        </Match>
                    </AllOf>
                </AnyOf>
            </Target>
            <Rule RuleId="DenyReadWithoutValidLawfulBasis" Effect="Deny">
                <Condition>
                    <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:not">
                        <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-is-in">
                            <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-one-and-only">
                                <AttributeDesignator Category="urn:oasis:names:tc:xacml:1.0:subject-category:access-subject"
                                                     AttributeId="lawful-basis"
                                                     DataType="http://www.w3.org/2001/XMLSchema#string"
                                                     MustBePresent="true"/>
                            </Apply>
                            <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-bag">
                                <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">consent</AttributeValue>
                                <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">contract</AttributeValue>
                                <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">legal-obligation</AttributeValue>
                                <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">vital-interests</AttributeValue>
                                <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">public-task</AttributeValue>
                                <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">legitimate-interests</AttributeValue>
                            </Apply>
                        </Apply>
                    </Apply>
                </Condition>
            </Rule>
        </Policy>
    </PolicySet>

    <!-- Hospital access policies -->
    <PolicySet xmlns="urn:oasis:names:tc:xacml:3.0:core:schema:wd-17"
            PolicySetId="HospitalPolicySet"
            Version="1.0"
            PolicyCombiningAlgId="urn:oasis:names:tc:xacml:1.0:policy-combining-algorithm:first-applicable">
        <Target />

        <Policy PolicyId="PatientOwnData" Version="1.0"
                RuleCombiningAlgId="urn:oasis:names:tc:xacml:1.0:rule-combining-algorithm:first-applicable">
            <Description>
                This policy implements the first rule: Patients can only access their own data. The
                target checks to ensure that the access-subject's "role" attribute is equal to the
                string "Patient." If it is, the rule defined below will apply.
            </Description>
            <Target>
                <AnyOf>
                    <AllOf>
                        <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                            <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">Patient</AttributeValue>
                            <AttributeDesignator Category="urn:oasis:names:tc:xacml:1.0:subject-category:access-subject"
                                                AttributeId="role" DataType="http://www.w3.org/2001/XMLSchema#string"
                                                MustBePresent="false"/>
                        </Match>
                    </AllOf>
                </AnyOf>
            </Target>
            <Rule RuleId="PatientOwnDataRule" Effect="Permit">
                <Description>
                    The rule itself checks to see if the access subject has the same ID as the resource
                    they are accessing. Given that both the access subject and the resource id need to
                    be accessed as an AttributeDesignator (since they are passed as part of the request)
                    which is allways interpreted as a bag, the rule checks for their equality using the
                    string-set-equals function instead of the string-equals function.
                </Description> 
                <Condition>
                    <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-set-equals">
                        <AttributeDesignator Category="urn:oasis:names:tc:xacml:1.0:subject-category:access-subject"
                                            AttributeId="id" DataType="http://www.w3.org/2001/XMLSchema#string"
                                            MustBePresent="false"/>
                        <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:resource"
                                            AttributeId="id" DataType="http://www.w3.org/2001/XMLSchema#string"
                                            MustBePresent="false"/>
                    </Apply>
                </Condition>
            </Rule>
        </Policy>

        <Policy PolicyId="EmployeeOwnData" Version="1.0"
                RuleCombiningAlgId="urn:oasis:names:tc:xacml:1.0:rule-combining-algorithm:first-applicable">
            <Description>
                This policy ensures that employees can only access their own data. The Target checks to
                ensure that the access subject is either a Clerk, an Accountaint, a Doctor, a Nurse, or
                an IT Admin. Since these are all of the possible employee roles, this rule will apply to
                any employee that accesses employee data.
            </Description>
            <Target>
                <!-- TODO: Fill me in. Remember that there are various types of employees! //Should be correct -->
                <AnyOf>
                    <AllOf>
                        <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                            <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">Clerk</AttributeValue>
                            <AttributeDesignator Category="urn:oasis:names:tc:xacml:1.0:subject-category:access-subject"
                                                AttributeId="role" DataType="http://www.w3.org/2001/XMLSchema#string"
                                                MustBePresent="false"/>
                        </Match>
                    </AllOf>
                    <AllOf>
                        <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                            <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">Accountant</AttributeValue>
                            <AttributeDesignator Category="urn:oasis:names:tc:xacml:1.0:subject-category:access-subject"
                                                AttributeId="role" DataType="http://www.w3.org/2001/XMLSchema#string"
                                                MustBePresent="false"/>
                        </Match>
                    </AllOf>
                    <AllOf>
                        <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                            <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">Doctor</AttributeValue>
                            <AttributeDesignator Category="urn:oasis:names:tc:xacml:1.0:subject-category:access-subject"
                                                AttributeId="role" DataType="http://www.w3.org/2001/XMLSchema#string"
                                                MustBePresent="false"/>
                        </Match>
                    </AllOf>
                    <AllOf>
                        <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                            <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">Nurse</AttributeValue>
                            <AttributeDesignator Category="urn:oasis:names:tc:xacml:1.0:subject-category:access-subject"
                                                AttributeId="role" DataType="http://www.w3.org/2001/XMLSchema#string"
                                                MustBePresent="false"/>
                        </Match>
                    </AllOf>
                    <AllOf>
                        <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                            <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">ITAdmin</AttributeValue>    
                            <AttributeDesignator Category="urn:oasis:names:tc:xacml:1.0:subject-category:access-subject"
                                                AttributeId="role" DataType="http://www.w3.org/2001/XMLSchema#string"
                                                MustBePresent="false"/>
                        </Match>
                    </AllOf>
                </AnyOf>
            </Target>
            <Rule RuleId="EmployeeOwnDataRule" Effect="Permit">
                <Description>
                    The rule itself checks to see if the access subject has the same ID as the resource
                    they are accessing. Given that both the access subject and the resource id need to
                    be accessed as an AttributeDesignator (since they are passed as part of the request)
                    which is allways interpreted as a bag, the rule checks for their equality using the
                    string-set-equals function instead of the string-equals function.
                </Description>
                <Condition>
                        <!-- TODO: Fill me in. //This should be fine. -->
                        <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-set-equals">
                        <AttributeDesignator Category="urn:oasis:names:tc:xacml:1.0:subject-category:access-subject"
                                            AttributeId="id" DataType="http://www.w3.org/2001/XMLSchema#string"
                                            MustBePresent="false"/>
                        <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:resource"
                                            AttributeId="id" DataType="http://www.w3.org/2001/XMLSchema#string"
                                            MustBePresent="false"/>
                    </Apply>
                </Condition>
            </Rule>
        </Policy>

        <Policy PolicyId="ClerkAppointmentData" Version="1.0"
                RuleCombiningAlgId="urn:oasis:names:tc:xacml:1.0:rule-combining-algorithm:first-applicable">
            <Description>
                This Policy implements rule 3: Clerks can only access Appointment Data for the purpose
                of scheduling and check-in. Our Target works by ensuring that the access-subject's role
                attribute is equal to the string literal "Clerk".
            </Description>
            <Target>
                <AnyOf>
                    <AllOf>
                        <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                            <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">Clerk</AttributeValue>
                            <AttributeDesignator Category="urn:oasis:names:tc:xacml:1.0:subject-category:access-subject"
                                                AttributeId="role" DataType="http://www.w3.org/2001/XMLSchema#string"
                                                MustBePresent="false"/>
                        </Match>
                    </AllOf>
                </AnyOf>
            </Target>
            <Rule RuleId="ClerkRule" Effect="Permit">
                <Description>
                    This rule is the first rule to use conditional logic operators such as AND and OR.
                    Specifically, this rule can be written as "Resource is AppointmentData AND Context
                    is Scheduling OR Context is Check-in. Note that we implement the logical operator
                    AND by calling a function in an Apply block that wraps all of the conditions. Though
                    our logic does include an OR in it, instead of implementing OR logic we do a trick
                    where we check if the Context is a subset of the set {Scheduling, Check-in}. So long
                    as only one context is passed, this is logically equivalent.
                </Description>
                <Condition>
                    <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:and">
                            <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                                <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">AppointmentData</AttributeValue>
                                <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-one-and-only">
                                    <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:resource"
                                                    AttributeId="resource-type"
                                                    DataType="http://www.w3.org/2001/XMLSchema#string"
                                                    MustBePresent="false"/>
                                </Apply>
                            </Apply>
                            <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-subset">
                                <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:environment"
                                                AttributeId="context" DataType="http://www.w3.org/2001/XMLSchema#string"
                                                MustBePresent="false"/>
                                <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-bag">
                                <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">Scheduling</AttributeValue>
                                <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">Check-in</AttributeValue>
                                </Apply>
                            </Apply>
                    </Apply>
                </Condition>
            </Rule>
        </Policy>

        <Policy PolicyId="AccountantBillingData" Version="1.0"
                RuleCombiningAlgId="urn:oasis:names:tc:xacml:1.0:rule-combining-algorithm:first-applicable">
            <Description>
                This Policy implements rule 4: Accountants can only access Payment Data or Employee Data
                for the purposes of Billing and Payment. The target applies to accountants, and this is
                checked by seeing if the access subject's role is equal to the string "Accountant".
            </Description>
            <Target>
                <!-- TODO: Fill me in. // -->
                <AnyOf>
                    <AllOf>
                        <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                            <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">Accountant</AttributeValue>
                            <AttributeDesignator Category="urn:oasis:names:tc:xacml:1.0:subject-category:access-subject"
                                                AttributeId="role" DataType="http://www.w3.org/2001/XMLSchema#string"
                                                MustBePresent="false"/>
                        </Match>
                    </AllOf>
                </AnyOf>
            </Target>
            <Rule RuleId="AccountantRule" Effect="Permit">
                <Description>
                    Here we use the logical AND operator between two conditions. The first condition
                    checks to see if the resource we are accessing is a subset of {PaymentData,
                    EmployeeData}. Assuming we receive only one resource, this is equivalent to the
                    logical expression Resource is PaymentData OR Resource is EmployeeData. We then
                    logically AND this with the string comparison between the string literal
                    "BillingAndPayment" and the context attribute.
                </Description>   
                <Condition>
                    <!-- TODO: Fill me in. // -->
                    <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:and">
                        <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:or">
                            <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                                <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">PaymentData</AttributeValue>
                                <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-one-and-only">
                                    <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:resource"
                                                    AttributeId="resource-type"
                                                    DataType="http://www.w3.org/2001/XMLSchema#string"
                                                    MustBePresent="false"/>
                                </Apply>
                            </Apply>
                            <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                                <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">EmployeeData</AttributeValue>
                                <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-one-and-only">
                                    <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:resource"
                                                    AttributeId="resource-type"
                                                    DataType="http://www.w3.org/2001/XMLSchema#string"
                                                    MustBePresent="false"/>
                                </Apply>
                            </Apply>
                        </Apply>
                            <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-subset">
                                <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:environment"
                                                AttributeId="context" DataType="http://www.w3.org/2001/XMLSchema#string"
                                                MustBePresent="false"/>
                                <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-bag">
                                <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">Billing and Payments</AttributeValue>
                                </Apply>
                            </Apply>
                    </Apply>
                </Condition>
            </Rule>
        </Policy>

        <Policy PolicyId="DoctorOwnPatientsNonEmergency" Version="1.0"
                RuleCombiningAlgId="urn:oasis:names:tc:xacml:1.0:rule-combining-algorithm:first-applicable">
            <Description>
                This Policy implements rule 5. Our target checks if the access subject's role is either
                the string literal "Doctor" or the string literal "Nurse". Note that a logical OR is not
                needed here, since the AnyOf and AllOf tags already handle this logic.
            </Description>
            <Target>
                <AnyOf>
                    <AllOf>
                        <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                            <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">Doctor</AttributeValue>
                            <AttributeDesignator Category="urn:oasis:names:tc:xacml:1.0:subject-category:access-subject"
                                                AttributeId="role" DataType="http://www.w3.org/2001/XMLSchema#string"
                                                MustBePresent="false"/>
                        </Match>
                    </AllOf>
                    <AllOf>
                        <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                            <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">Nurse</AttributeValue>
                            <AttributeDesignator Category="urn:oasis:names:tc:xacml:1.0:subject-category:access-subject"
                                                AttributeId="role" DataType="http://www.w3.org/2001/XMLSchema#string"
                                                MustBePresent="false"/>
                        </Match>
                    </AllOf>
                </AnyOf>
            </Target>
            <Rule RuleId="DoctorOwnPatientRule" Effect="Permit">
                <Description>
                    This rule is implemented via a simple comparison between the access subject's ID and
                    the patient's Doctor ID and a logical AND asserting that the resource being accessed
                    is patient data.
                </Description>
                <Condition>
                    <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:and">
                        <!-- 1. Not an emergency -->
                        <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:not">
                            <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-is-in">
                                <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">Emergency</AttributeValue>
                                <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:environment"
                                                     AttributeId="context" DataType="http://www.w3.org/2001/XMLSchema#string"
                                                     MustBePresent="false"/>
                            </Apply>
                        </Apply>
                        <!-- 2. The subject is the patient's doctor -->
                        <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-set-equals">
                            <AttributeDesignator Category="urn:oasis:names:tc:xacml:1.0:subject-category:access-subject"
                                                 AttributeId="id" DataType="http://www.w3.org/2001/XMLSchema#string"
                                                 MustBePresent="false"/>
                            <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:resource"
                                                 AttributeId="doctorId" DataType="http://www.w3.org/2001/XMLSchema#string"
                                                 MustBePresent="false"/>
                        </Apply>
                        <!-- 3. PatientData or AppointmentData -->
                        <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-subset">
                            <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:resource"
                                                 AttributeId="resource-type" DataType="http://www.w3.org/2001/XMLSchema#string"
                                                 MustBePresent="false"/>
                            <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-bag">
                                <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">PatientData</AttributeValue>
                                <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">AppointmentData</AttributeValue>
                            </Apply>
                        </Apply>
                    </Apply>
                </Condition>
            </Rule>
        </Policy>

        <Policy PolicyId="DoctorEmergency" Version="1.0"
                RuleCombiningAlgId="urn:oasis:names:tc:xacml:1.0:rule-combining-algorithm:first-applicable">
            <Description>
                This Policy implements rule 6, which allows doctors and nurses to access any patient
                data in an emergency. This works by checking that the access subject's role is Doctor
                and the context is Emergency, or the access subject's role is Nurse and the context is
                Emergency.
            </Description>
            <Target>
                <AnyOf>
                    <AllOf>
                        <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                            <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">Emergency</AttributeValue>
                            <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:environment"
                                                AttributeId="context" DataType="http://www.w3.org/2001/XMLSchema#string"
                                                MustBePresent="false"/>
                        </Match>
                    </AllOf>
                </AnyOf>
                <AnyOf>
                    <AllOf>
                        <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                            <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">Doctor</AttributeValue>
                            <AttributeDesignator Category="urn:oasis:names:tc:xacml:1.0:subject-category:access-subject"
                                                AttributeId="role" DataType="http://www.w3.org/2001/XMLSchema#string"
                                                MustBePresent="false"/>
                        </Match>
                    </AllOf>
                    <AllOf>
                        <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                            <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">Nurse</AttributeValue>
                            <AttributeDesignator Category="urn:oasis:names:tc:xacml:1.0:subject-category:access-subject"
                                                AttributeId="role" DataType="http://www.w3.org/2001/XMLSchema#string"
                                                MustBePresent="false"/>
                        </Match>
                    </AllOf>
                </AnyOf>
            </Target>
            <Rule RuleId="DoctorEmergencyRule" Effect="Permit">
                <Description>
                    Given that we already checked the role in the target, here we need to check the
                    context and ensure that the resource being accessed is PatientData.
                </Description>
                <Condition>
                    <!-- TODO: Fill me in. // -->
                    <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-subset">
                            <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:resource"
                                            AttributeId="resource-type" DataType="http://www.w3.org/2001/XMLSchema#string"
                                            MustBePresent="false"/>
                            <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-bag">
                                <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">PatientData</AttributeValue>
                            </Apply>
                        </Apply>
                </Condition>
            </Rule>
        </Policy>

        <Policy PolicyId="ITAdminEmergency" Version="1.0"
